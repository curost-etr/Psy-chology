PSYCOLLM_API_KEY=your_huggingface_token
PSYCOLLM_MODEL=MindIntLab/PsycoLLM
PSYCOLLM_API_BASE_URL=https://router.huggingface.co/v1
PSYCOLLM_CHAT_PATH=/chat/completions
# If you have your own deployed PsycoLLM endpoint, set PSYCOLLM_API_URL directly instead.
# Example:
# PSYCOLLM_API_URL=https://your-domain.example.com/v1/chat/completions
PSYCOLLM_TIMEOUT_MS=20000

# Local Ollama. Leave OLLAMA_MODEL empty to auto-select when exactly one model is installed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=180000
# Start local Ollama automatically when CHAT_PROVIDER=ollama.
OLLAMA_AUTO_START=true
OLLAMA_STARTUP_TIMEOUT_MS=30000
# OLLAMA_BIN=C:\Users\your-name\AppData\Local\Programs\Ollama\ollama.exe

# Set to deepseek to use the hosted API; use ollama for local inference.
CHAT_PROVIDER=ollama
CHAT_ALLOWED_ORIGINS=https://curost-etr.github.io
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=180000
